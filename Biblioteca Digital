@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: Arial, Helvetica, sans-serif; background: rgb(245, 245, 245); color: rgb(17, 17, 17); }

.contenedor { width: 90%; max-width: 1260px; margin: auto; }

a { text-decoration: none; color: inherit; }

header { background: white; border-bottom: 1px solid rgb(119, 119, 119); position: sticky; top: 0px; z-index: 100; }

.header { min-height: 75px; display: grid; grid-template-columns: 180px 1fr 150px; align-items: center; gap: 30px; }

.logo { border: 2px solid rgb(51, 51, 51); padding: 8px 15px; font-size: 20px; font-weight: bold; text-align: center; }

nav { display: flex; justify-content: center; gap: 40px; }

nav a { font-weight: bold; }

nav a:hover { text-decoration: underline; }

.boton { display: inline-block; border: 2px solid rgb(51, 51, 51); background: white; color: rgb(17, 17, 17); padding: 11px 25px; border-radius: 5px; font-weight: bold; text-align: center; cursor: pointer; }

.boton:hover { background: rgb(34, 34, 34); color: white; }

.hero { min-height: 390px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 45px; }

.hero-text h1 { font-size: 48px; line-height: 1; margin-bottom: 18px; }

.hero-text p { line-height: 1.5; margin-bottom: 20px; max-width: 600px; }

.hero-imagen { height: 300px; border: 2px solid rgb(119, 119, 119); background: rgb(221, 221, 221); overflow: hidden; }

.hero-imagen img { width: 100%; height: 100%; object-fit: cover; }

.seccion { padding: 30px 0px; }

.titulo-seccion { text-align: center; margin-bottom: 20px; }

.titulo-seccion h2 { font-size: 28px; margin-bottom: 5px; }

.categorias { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.categoria { background: white; border: 2px solid rgb(136, 136, 136); padding: 25px; text-align: center; border-radius: 5px; }

.icono { font-size: 40px; margin-bottom: 10px; }

.categoria h3 { margin-bottom: 10px; }

.categoria p { margin-bottom: 15px; }

.categoria button { padding: 8px 18px; background: rgb(238, 238, 238); border: 1px solid rgb(85, 85, 85); cursor: pointer; }

.categoria button:hover { background: rgb(34, 34, 34); color: white; }

.buscador-contenedor { max-width: 700px; margin: 0px auto 25px; }

#buscador { width: 100%; padding: 14px; border: 2px solid rgb(119, 119, 119); font-size: 16px; }

.catalogo { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

.libro { background: white; border: 2px solid rgb(136, 136, 136); border-radius: 5px; overflow: hidden; transition: 0.2s; }

.libro:hover { transform: translateY(-4px); }

.libro > img { width: 100%; height: 230px; object-fit: cover; display: block; background: rgb(221, 221, 221); }

.libro-info { padding: 15px; text-align: center; }

.libro-info h3 { margin-bottom: 8px; }

.libro-info p { color: rgb(85, 85, 85); margin-bottom: 15px; }

.libro-info button { width: 100%; padding: 10px; background: rgb(51, 51, 51); color: white; border: none; cursor: pointer; }

.libro-info button:hover { background: rgb(17, 17, 17); }

.contacto { background: white; border-top: 1px solid rgb(119, 119, 119); border-bottom: 1px solid rgb(119, 119, 119); padding: 30px 0px; }

.contacto-grid { display: grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 40px; }

.contacto h2 { margin-bottom: 15px; }

.informacion p { margin-bottom: 10px; line-height: 1.5; }

.formulario form { display: flex; flex-direction: column; gap: 10px; }

.formulario input, .formulario textarea { width: 100%; padding: 11px; border: 1px solid rgb(119, 119, 119); font-family: inherit; }

.formulario textarea { height: 90px; resize: vertical; }

.redes-botones { display: flex; gap: 10px; }

.redes-botones a { border: 2px solid rgb(85, 85, 85); padding: 8px 20px; border-radius: 5px; font-weight: bold; }

.redes-botones a:hover { background: rgb(34, 34, 34); color: white; }

footer { background: rgb(34, 34, 34); color: white; text-align: center; padding: 20px; }

.modal { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.6); display: none; align-items: center; justify-content: center; z-index: 1000; }

.modal-contenido { background: white; width: 90%; max-width: 500px; padding: 35px; text-align: center; border-radius: 8px; position: relative; }

.modal-contenido h2 { margin-bottom: 15px; }

.modal-contenido p { line-height: 1.5; margin-bottom: 20px; }

.cerrar { position: absolute; right: 15px; top: 8px; background: none; border: none; font-size: 28px; cursor: pointer; }

@media (max-width: 900px) {
  .header { grid-template-columns: 1fr; padding: 15px 0px; }
  nav { flex-wrap: wrap; gap: 20px; }
  .hero { grid-template-columns: 1fr; }
  .categorias { grid-template-columns: 1fr; }
  .catalogo { grid-template-columns: repeat(2, 1fr); }
  .contacto-grid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .hero-text h1 { font-size: 35px; }
  .catalogo { grid-template-columns: 1fr; }
  nav { flex-direction: column; text-align: center; }
}
